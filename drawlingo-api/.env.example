# Env file cascade (loaded by src/configs/dotenv.config.ts):
# real process env (Docker env_file, CI, shell) > .env.<mode>.local > .env.local > .env.<mode> > .env
# where <mode> comes from NODE_ENV (default "development").
# In test mode only .env.test.local and .env.test are read (.env and .env.local are ignored).
# Keys with defaults in the Zod schema (src/configs/env.config.ts) are optional here;
# CLIENT_URL, REDIS_HOST and REDIS_PORT are required.

# Server
PORT=5050
NODE_ENV=development
BASE_URL=
CLIENT_URL=http://localhost:3000
SEED_DEFAULT_DATA=false

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Rate limit (max=0 disables limiting; window in ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=0

# JSON / urlencoded body size limit (e.g. 100kb, 1mb, 1gb)
BODY_LIMIT=1gb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Hot Reload docker
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=100